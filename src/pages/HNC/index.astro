---
import Layout from 'src/layouts/Layout.astro';
import GitHub from 'src/components/GitHub.astro';

import MediaGrid from 'src/components/MediaGrid.astro';
import MediaElement from 'src/components/MediaElement.astro';
---

<Layout page="HNC">
	<div class="project">
		<h3>Pitch a Treatment: Board?</h3>
        <MediaElement media='logo.png' location='HNC/Pitch' type="img" style='float:left'></MediaElement>

        <p>
            My "Dream" game, or at least so at the time. For pitch a treatment we were tasked to create a game and I decided to make a mock up
            of an idea I've had for sometime about a game similar to <a href="en.wikipedia.org/wiki/42_All_Time_Classics">42 All Time Classics</a>, 
            or at the time new <a href="https://en.wikipedia.org/wiki/51_Worldwide_Classics">51 Worldwide Games</a> but for mobile and PC. The 
            colour palette was vaguely based on <a href="https://en.wikipedia.org/wiki/Uno_(video_game)">UNO video game</a>.
        </p>
        
        <MediaGrid media={["Pawn.png", "BlackJack.png", "Domino.png", "Snap.png", "Backgammon.png", "Blokus.png", "Go.png", "Tic Tac Toe.png","Tetromino.png", "GameOfUr.png", "ChutesAndLadders.png"]} location='HNC/Pitch' type='img'></MediaGrid>
    </div>

    <div class="project">
		<h3>UE4 Level Design</h3>
        <MediaElement media='UELevel.mp4' location='HNC/LevelDesign' type="video" style='float:left'></MediaElement>

        <p>
            For the level design class we tasked to make a small themed level using the default UE4 shooter game template and some free asset packs;
            <a href="https://www.fab.com/listings/c935ca3e-dbb1-4b7d-a080-65de129c60bd">Stylised Egypt</a> and <a href="https://www.fab.com/listings/c935ca3e-dbb1-4b7d-a080-65de129c60bd">
            Modular Military Operation - Arabian Pack</a> and create a level based upon this mock up I made.
        </p>

        <MediaElement media='LevelMockup.png' location='HNC/LevelDesign' type='img' style='width:200px'></MediaElement>

    </div>
    
    <div class="project">
        <h3>Software Development: Infestation</h3>
        <GitHub repo="Infestation" author="Skylarx23"></GitHub>

        <MediaElement media='InfestationBoss.mp4' location='HNC/Infestation' type='video'></MediaElement>

    </div>
</Layout>