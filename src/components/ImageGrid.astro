---
import MediaElement from "src/components/MediaElement.astro";

interface Props {
  images: string[];
  location: string;
  link?: string;
}

const { images, location, link } = Astro.props;

function GetAnchorLink(image: String)
{
  return  link ? link : image;
}

function GetAltText(image: String)
{
  return image.split(".")[0];
}
---

<div class="ImageGrid">
    <slot/>
    {
        images.map((image: string) => <MediaElement media={image} location={location} link={link} type="img"></MediaElement>)
    }
</div>