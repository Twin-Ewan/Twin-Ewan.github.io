---
interface Props {
  images: string[];
  location: string;
  link?: string;
}

const { images, location, link } = Astro.props;

function GetAnchorLink(image: String)
{
  return  link ? link : image;
}

function GetAltText(image: String)
{
  return image.split(".")[0];
}
---

<div class="ImageGrid">
    <slot/>
    {
        images.map((image: string) => <a href={`/${location}/${GetAnchorLink(image)}`}>
          <img src={`/${location}/${image}`} alt={`/${location}/AltText/${GetAltText(image)}.txt`}></a>)
    }
</div>