---
interface Props {
  images: string[];
  location: string;
  link?: string;
}

const { images, location, link } = Astro.props;

function GetAnchorLink(image: String)
{
  return  link ? link : image;
}
---

<div class="ImageGrid" style="display:flex; overflow-x:auto">
    <slot/>
    {
        images.map((image: string) => <a href={`/${location}/${GetAnchorLink(image)} }`}><img src={`/${location}/${image}`}></a>)
    }
</div>