---
interface Props {
  images: string[];
  location: string;
  link?: string;
}

const { images, location, link } = Astro.props;
---

<div class="ImageGrid" style="display:flex; overflow-x:auto">
    <slot/>
    {
        images.map((image: string) => <a href={`/${location}/ {${link} ? ${link} : ${image}}`}><img src={`/${location}/${image}`}></a>)
    }
</div>