---
interface Props {
  images: string[];
  location: string;
}

const { images, location } = Astro.props;
---

<div class="ImageGrid" style="display:flex; overflow-x:auto">
    <slot/>
    {
        images.map((image: string) => <a href={`/${location}/${image}`}><img src={`/${location}/${image}`}></a>)
    }
</div>