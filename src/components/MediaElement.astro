---
import { Debug } from "astro:components";
import fs from 'node:fs';

interface Props {
  media: string;
  type: string;
  location: string;
  ID?: string;
  AltText?: string;
  style?: string;
  link?: string;
}

const { media, type, location, ID, AltText, style, link } = Astro.props;

function GetAnchorLink(Media: String)
{
  return  link ? link : Media;
}   

function GetElementType()
{
    let HTMLElement = `<${type} `;
    HTMLElement += ID ? `class="${ID}"` : "";

    switch(type)
    {
        case "img":
        {
            HTMLElement += `src="/${location}/${media}" alt='${GetAltText(media)}'`;
        }
        break;

        case "iframe":
        {
            HTMLElement += `src="${location}/${media}"`;
        }
        break;

        case "video":
        {
            HTMLElement += `src="/${location}/${media}" style="${style}" controls>`;
            HTMLElement += GetAltText(media);
        }
        break;

        default:
        {
            HTMLElement = `<h1>Error</h1>`
        }
        break;
    }

    if(type != "video") HTMLElement += `style="${style}">`;

    HTMLElement += `</${type}>`;
    return HTMLElement;
}

function GetAltText(Media: String)
{
    if(AltText) return AltText;
    else
    {
        try 
        {
            return fs.readFileSync(`public/${location}/AltText/${Media.split(".")[0]}.txt`, 'utf8');
        } 
        catch(err)
        {
            return "";
        }
    }
}

function CreateElement()
{
    let Element;

    if(type != "video" && type != "iframe")
    {
        Element = `<a href=/${location}/${GetAnchorLink(media)}>`;
        Element += GetElementType();
        Element += "</a>";
    }
    else
    {
        Element = GetElementType();
    }

    return Element;
}
---


<Fragment set:html={CreateElement()}/>
